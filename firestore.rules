// ─────────────────────────────────────────────────────────────
// firestore.rules — กฎเฝ้าข้อมูลขั้นต่ำของสัปดาห์ที่ 7
// "ต้องล็อกอินก่อน ถึงอ่าน/เขียนได้" ครอบทุกโฟลเดอร์ รวมโฟลเดอร์ย่อย approvals
// กฎรายห้อง (ใครเห็นใบใคร) เป็นงานของสัปดาห์ที่ 8 — ยังไม่ทำในไฟล์นี้
// ─────────────────────────────────────────────────────────────
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
